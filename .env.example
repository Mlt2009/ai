# ── Brain ─────────────────────────────────────────────────────────
# Mehltani runs on EITHER Gemini or OpenAI — one key is enough for the whole
# workspace (orchestrator, reading receipts from photos, merging the council).
#
# Option A — OpenAI: https://platform.openai.com/api-keys
#   OPENAI_API_KEY is set further down, under "AI companions".
#   Use a vision-capable OPENAI_MODEL (gpt-4o) or receipt scanning won't work.
# Option B — Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "latest" alias always tracks Google's newest fast model
GEMINI_MODEL=gemini-flash-latest
# auto = Gemini if keyed, else OpenAI. Pin with "gemini" or "openai".
BRAIN_PROVIDER=auto

# ── Home Assistant ────────────────────────────────────────────────
# Long-lived access token: HA profile → Security → Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ── 3D Printer (OctoPrint) ───────────────────────────────────────
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_API_KEY=

# ── Paper printer (CUPS) ─────────────────────────────────────────
# Leave blank to use the system default printer
CUPS_PRINTER=

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Real-time data ───────────────────────────────────────────────
# Default location for weather (lat,lon). Example: New York
WEATHER_LAT=40.71
WEATHER_LON=-74.01

# ── Desktop app (A.D.A.) — optional premium TTS ──────────────────
# Without this the desktop app runs text-only; the web app always
# speaks using free browser voices.
ELEVENLABS_API_KEY=

# ── Computer control safety ──────────────────────────────────────
# Set to "true" to let the Computer Agent run arbitrary shell commands
# (otherwise only the safe built-in actions are allowed)
ALLOW_SHELL=false

# ── AI companions (Council agent broadcasts to all of these) ─────
# Every key you fill in becomes another brain the "ask all" button reaches.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
# Must support vision if OpenAI is your brain and you scan receipts
OPENAI_MODEL=gpt-4o
# Point at a proxy, Azure gateway or local server instead of api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Any OpenAI-compatible endpoint: name|base_url|model|api_key, comma separated.
# Works for a local Ollama / LM Studio, your own router, a self-hosted agent.
#   COMPANION_ENDPOINTS=ollama|http://localhost:11434/v1|llama3|,work|https://my-router/v1|auto|sk-xxx
COMPANION_ENDPOINTS=

# ── Printed receipt / work-order slip ────────────────────────────
BUSINESS_NAME=
BUSINESS_PHONE=
# Characters per line: 32 = 58mm thermal roll, 40 = 80mm roll, 64 = letter paper
RECEIPT_WIDTH=32
RECEIPT_FOOTER=Thank you for your business

# ── File control ─────────────────────────────────────────────────
# Folders the Files agent may touch, separated by : (Linux/macOS) or ; (Windows).
# Use * for the whole computer. Defaults to your home folder.
#   FILE_ROOTS=C:\Users\me
FILE_ROOTS=
# Set to "true" to allow writing, moving and deleting files. Reads work either way.
ALLOW_FILE_WRITE=false

# ── Remote access ────────────────────────────────────────────────
# REQUIRED before exposing this server past your own Wi-Fi. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=

# ── Storage ──────────────────────────────────────────────────────
# Where the expense ledger, uploaded photos and exports live (default ./data)
DATA_DIR=

# ── Identity ─────────────────────────────────────────────────────
OWNER_NAME=

# ── Biometric gate (Touch ID / Face ID / Windows Hello / Android) ──
# Protects shutdown, spending, sending mail/messages, revealing secrets, and
# changes to Mehltani's own code — never blocks Ctrl-C, kill, or closing the
# lid. See docs in server/guardian.py before touching these.
#
# RP_ID must match the domain in the browser's address bar (no scheme, no
# port) — "localhost" is correct for local-only use. If you put this behind
# a tunnel/reverse proxy, set RP_ID to that hostname and add it once more,
# with scheme, to EXTRA_ORIGINS if the tunnel uses a different origin.
RP_ID=localhost
EXTRA_ORIGINS=
REQUIRE_BIOMETRIC=true
# Escape hatch if your enrolled device is lost — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Using it is logged as a threat, on purpose.
RECOVERY_KEY=
# Automatically freeze protected operations on a critical threat (a failed
# integrity check, a brute-force burst of failed fingerprint checks).
AUTO_LOCKDOWN=true

# ── WhatsApp Business Cloud API ─────────────────────────────────────
# developers.facebook.com → your Meta app → WhatsApp → API Setup.
# Webhook URL: https://<your-host>/api/whatsapp/webhook
# Verify token: whatever you put in WHATSAPP_VERIFY_TOKEN below.
# Subscribe the app to the "messages" webhook field.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret, for verifying the webhook's HMAC signature — Meta app → Settings → Basic
WHATSAPP_APP_SECRET=
# Your own number, country code + digits, no plus sign: 14155551234
WHATSAPP_OWNER=

# ── Google Workspace (Gmail, Drive, Calendar) ───────────────────────
# Run `python -m server.integrations.google_ws` and follow the prompts —
# it walks the OAuth flow and prints these three values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── Microsoft 365 (Outlook, OneDrive, Calendar, Teams) ──────────────
# Run `python -m server.integrations.microsoft_ws` and follow the prompts.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT=common
MS_REFRESH_TOKEN=

# ── Meta glasses ─────────────────────────────────────────────────────
# There is no public streaming API for Ray-Ban Meta glasses yet. Two routes
# that work today: say "Hey Meta, send a photo" to your WhatsApp Business
# number above (fastest), or point this at a folder your camera roll syncs
# to (iCloud Photos, Google Photos desktop, Syncthing, Dropbox).
GLASSES_WATCH_DIR=

# ── Image generation (photoshoot mockups) ───────────────────────────
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
OPENAI_IMAGE_MODEL=gpt-image-1
