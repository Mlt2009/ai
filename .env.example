# ── Brain ─────────────────────────────────────────────────────────
# Atlas runs on EITHER Gemini or OpenAI — one key is enough for the whole
# workspace (orchestrator, reading receipts from photos, merging the council).
#
# Option A — OpenAI: https://platform.openai.com/api-keys
#   OPENAI_API_KEY is set further down, under "AI companions".
#   Use a vision-capable OPENAI_MODEL (gpt-4o) or receipt scanning won't work.
# Option B — Gemini (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "latest" alias always tracks Google's newest fast model
GEMINI_MODEL=gemini-flash-latest
# auto = Gemini if keyed, else OpenAI. Pin with "gemini" or "openai".
BRAIN_PROVIDER=auto

# ── Home Assistant ────────────────────────────────────────────────
# Long-lived access token: HA profile → Security → Long-lived access tokens
HA_URL=http://homeassistant.local:8123
HA_TOKEN=

# ── 3D Printer (OctoPrint) ───────────────────────────────────────
OCTOPRINT_URL=http://octopi.local
OCTOPRINT_API_KEY=

# ── Paper printer (CUPS) ─────────────────────────────────────────
# Leave blank to use the system default printer
CUPS_PRINTER=

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Real-time data ───────────────────────────────────────────────
# Default location for weather (lat,lon). Example: New York
WEATHER_LAT=40.71
WEATHER_LON=-74.01

# ── Desktop app (A.D.A.) — optional premium TTS ──────────────────
# Without this the desktop app runs text-only; the web app always
# speaks using free browser voices.
ELEVENLABS_API_KEY=

# ── Computer control safety ──────────────────────────────────────
# Set to "true" to let the Computer Agent run arbitrary shell commands
# (otherwise only the safe built-in actions are allowed)
ALLOW_SHELL=false

# ── AI companions (Council agent broadcasts to all of these) ─────
# Every key you fill in becomes another brain the "ask all" button reaches.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=
# Must support vision if OpenAI is your brain and you scan receipts
OPENAI_MODEL=gpt-4o
# Point at a proxy, Azure gateway or local server instead of api.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Any OpenAI-compatible endpoint: name|base_url|model|api_key, comma separated.
# Works for a local Ollama / LM Studio, your own router, a self-hosted agent.
#   COMPANION_ENDPOINTS=ollama|http://localhost:11434/v1|llama3|,work|https://my-router/v1|auto|sk-xxx
COMPANION_ENDPOINTS=

# ── Printed receipt / work-order slip ────────────────────────────
BUSINESS_NAME=
BUSINESS_PHONE=
# Characters per line: 32 = 58mm thermal roll, 40 = 80mm roll, 64 = letter paper
RECEIPT_WIDTH=32
RECEIPT_FOOTER=Thank you for your business

# ── File control ─────────────────────────────────────────────────
# Folders the Files agent may touch, separated by : (Linux/macOS) or ; (Windows).
# Use * for the whole computer. Defaults to your home folder.
#   FILE_ROOTS=C:\Users\me
FILE_ROOTS=
# Set to "true" to allow writing, moving and deleting files. Reads work either way.
ALLOW_FILE_WRITE=false

# ── Remote access ────────────────────────────────────────────────
# REQUIRED before exposing this server past your own Wi-Fi. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ACCESS_TOKEN=

# ── Storage ──────────────────────────────────────────────────────
# Where the expense ledger, uploaded photos and exports live (default ./data)
DATA_DIR=

# ── Invoicing ────────────────────────────────────────────────────
# Sales tax percent applied to invoices, e.g. 8.25 (blank = no tax)
TAX_RATE=
# Default payment terms in days
INVOICE_TERMS_DAYS=30

# ── Mileage ──────────────────────────────────────────────────────
# Per-mile deduction rate. Deliberately blank: rates change every tax year,
# so set the one published for YOUR tax year and jurisdiction rather than
# trusting a default that may be stale by the time you file.
MILEAGE_RATE=

# ── Email (Mail agent) ───────────────────────────────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, IMAP_HOST=imap.gmail.com, and an
# app password (not your account password) in SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
IMAP_HOST=
IMAP_PORT=993
